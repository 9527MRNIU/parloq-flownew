{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parloq.example/schemas/parloq-promotion-template-v1.schema.json",
  "title": "Parloq Promotion Template v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "entry",
    "format",
    "capabilities",
    "runtime",
    "interactionProtection",
    "defaultLocale",
    "supportedLocales",
    "i18n"
  ],
  "properties": {
    "schema": {
      "const": "parloq-promotion-template/v1"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "entry": {
      "const": "index.html"
    },
    "format": {
      "enum": ["static-bundle", "vite-dist"]
    },
    "capabilities": {
      "type": "array",
      "const": ["phone-pairing"]
    },
    "runtime": {
      "const": "parloq-browser-bridge/v1"
    },
    "interactionProtection": {
      "const": "platform"
    },
    "defaultLocale": {
      "$ref": "#/$defs/locale"
    },
    "supportedLocales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/locale"
      }
    },
    "i18n": {
      "type": "object",
      "required": ["mode", "path", "fallbackLocale"],
      "properties": {
        "mode": {
          "enum": ["bundled", "runtime"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "fallbackLocale": {
          "$ref": "#/$defs/locale"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z]{2,4})?$"
    }
  },
  "additionalProperties": true
}
