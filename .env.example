# Local Docker development only. Copy this file to .env before overriding values.
COMPOSE_PROJECT_NAME=parloq-flow

# Published ports
WEB_PORT=5173
API_PORT=8000
WA_GATEWAY_PORT=8010
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL
POSTGRES_DB=parloq_flow
POSTGRES_USER=parloq
POSTGRES_PASSWORD=parloq-local
DATABASE_URL=postgresql+psycopg://parloq:parloq-local@postgres:5432/parloq_flow

# Redis
REDIS_URL=redis://redis:6379/0
PROMOTION_EVENT_RATE_LIMIT_MOCK=false

# First local administrator. These defaults are intentionally development-only.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin

# API/auth development settings. Replace before any shared environment is created.
APP_ENV=development
APP_SECRET_KEY=local-only-change-before-shared-environment
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_TABLES=true

# Login abuse controls are Redis-backed. Production enables them together with
# Cloudflare Turnstile; local development keeps them off by default.
LOGIN_SECURITY_ENABLED=false
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional locally. Production uses a dedicated, versioned Fernet keyring so
# application secrets are not coupled to APP_SECRET_KEY and can be rotated.
DATA_ENCRYPTION_ACTIVE_KEY_ID=
DATA_ENCRYPTION_KEYS=

# Local direct-short-link development uses the API's deterministic Bitly mock.
# Set this to false only after a real Bitly credential is configured in the app.
BITLY_MOCK=true

# Domain integration. The mock supports quote -> payment -> provision and
# unknown -> reconcile without contacting a registrar or DNS provider.
DOMAIN_VERIFY_MOCK=true
DOMAIN_REGISTRAR_MOCK=true
# Adds deterministic Cloudflare/NameSilo inventory rows for local Badge review.
DEV_PROVIDER_DOMAIN_FIXTURES=true
PROMOTION_INGRESS_HOST=promotion.localhost
PROMOTION_INTEGRATION_PUBLIC_SCHEME=http
PROMOTION_INTEGRATION_PUBLIC_PORT=5173
PROMOTION_SUCCESS_WEBHOOK_SECRET=local-promotion-success-secret-change-before-shared-environment

# Vite forwards /api to this Docker-internal address.
VITE_API_PROXY_TARGET=http://api:8000

# WhatsApp gateway. Local development intentionally boots with the deterministic
# mock engine. Set WA_ENGINE=baileys only for an explicit disposable-account
# test with a fixed proxy; the production adapter persists credentials and its
# Signal key store in PostgreSQL, so restarts do not require re-pairing.
WA_ENGINE=mock
WA_GATEWAY_ADDR=:8010
WA_GATEWAY_INSTANCE_ID=local-wa-gateway-1
WA_GATEWAY_API_TOKEN=local-wa-gateway-token-change-before-shared-environment
WA_GATEWAY_MOCK=false
WA_GATEWAY_DATABASE_URL=postgresql://parloq:parloq-local@postgres:5432/parloq_flow
WA_GATEWAY_SEND_QPS=10
WA_GATEWAY_ACCOUNT_QUEUE_SIZE=1000
WA_GATEWAY_DATABASE_MAX_CONNECTIONS=50

# Signed delivery-status callback into the local control plane.
WA_GATEWAY_WEBHOOK_URL=http://api:8000/api/internal/wa-gateway/events
WA_GATEWAY_WEBHOOK_SECRET=local-wa-gateway-webhook-secret-change-before-shared-environment
WA_GATEWAY_WEBHOOK_RETRIES=3

# Redis-backed hyperlink-task worker. Keep this bounded below the gateway's
# global send slots; the gateway independently enforces 10 QPS per account.
TASK_QUEUE_MOCK=false
TASK_WORKER_MAX_CONCURRENCY=200
API_SNOWFLAKE_NODE_ID=1
WORKER_SNOWFLAKE_NODE_ID=2
WA_GATEWAY_SNOWFLAKE_NODE_ID=3
