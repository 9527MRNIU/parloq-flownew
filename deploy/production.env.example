# Production template only. The real file lives at
# /www/server/panel/data/compose/parloq-flow/.env with mode 600.
COMPOSE_PROJECT_NAME=parloq-flow
PARLOQ_PERSIST_ROOT=/data/parloq-flow
PARLOQ_HTTP_PORT=18100

# Immutable images are built on the local Mac and uploaded to the server.
PARLOQ_API_IMAGE=parloq-flow-api-local:replace-with-commit
PARLOQ_WEB_IMAGE=parloq-flow-web-local:replace-with-commit
PARLOQ_WA_GATEWAY_IMAGE=parloq-flow-wa-gateway-local:replace-with-commit

POSTGRES_DB=parloq_flow
POSTGRES_USER=parloq_flow
POSTGRES_PASSWORD=change-me-strong-postgres-password

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-strong-admin-password
APP_SECRET_KEY=change-me-at-least-32-random-characters
AUTH_COOKIE_NAME=parloq_flow_session
AUTH_SESSION_HOURS=336
CORS_ORIGINS=https://center.parloq.com

BITLY_MOCK=false
IP_PROXY_MOCK=false
DOMAIN_VERIFY_MOCK=false
DOMAIN_REGISTRAR_MOCK=false
PROMOTION_INGRESS_HOST=center.parloq.com
PROMOTION_SUCCESS_WEBHOOK_SECRET=change-me-independent-32-character-secret

WA_GATEWAY_INSTANCE_ID=parloq-flow-prod-1
WA_GATEWAY_API_TOKEN=change-me-independent-32-character-token
WA_GATEWAY_WEBHOOK_SECRET=change-me-independent-webhook-secret
WA_GATEWAY_SEND_QPS=10
WA_GATEWAY_ACCOUNT_QUEUE_SIZE=1000
WA_GATEWAY_DATABASE_MAX_CONNECTIONS=50
WA_GATEWAY_WEBHOOK_RETRIES=3
WA_GATEWAY_LOG_LEVEL=info

TASK_WORKER_MAX_CONCURRENCY=200
