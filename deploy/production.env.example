# Production template only. The real file lives at
# /www/server/panel/data/compose/parloq-flow/.env with mode 600.
COMPOSE_PROJECT_NAME=parloq-flow
PARLOQ_PERSIST_ROOT=/data/parloq-flow
PARLOQ_HTTP_PORT=18100

# The one-command release runs inside the production server checkout and asks
# Compose to build directly from these local source directories. The read-only
# GitHub token is stored separately in ./github-token (mode 600) and is used
# only by the release script's `git fetch`.
PARLOQ_SOURCE_ROOT=/root/parloq-flow
PARLOQ_GIT_REF=main
PARLOQ_APP_PULL_POLICY=build
PARLOQ_API_IMAGE=parloq-flow-api-server:latest
PARLOQ_WEB_IMAGE=parloq-flow-web-server:latest
PARLOQ_WA_GATEWAY_IMAGE=parloq-flow-wa-gateway-server:latest

POSTGRES_DB=parloq_flow
POSTGRES_USER=parloq_flow
POSTGRES_PASSWORD=change-me-strong-postgres-password

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-strong-admin-password
APP_SECRET_KEY=change-me-at-least-32-random-characters
AUTH_COOKIE_NAME=parloq_flow_session
AUTH_SESSION_HOURS=336
CORS_ORIGINS=https://center.parloq.com

# Reuse the existing Cloudflare account, but create a separate Turnstile widget
# and secret for center.parloq.com. Never copy a secret from the old system.
LOGIN_LOCK_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=600
LOGIN_USER_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=20
TURNSTILE_SITE_KEY=replace-with-cloudflare-site-key
TURNSTILE_SECRET_KEY=replace-with-cloudflare-secret-key

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep old entries in the JSON object while rotating; change only the active ID
# for new writes, then retire an old key after all values have been rewritten.
DATA_ENCRYPTION_ACTIVE_KEY_ID=primary-2026-08
DATA_ENCRYPTION_KEYS={"primary-2026-08":"replace-with-generated-fernet-key"}

BITLY_MOCK=false
IP_PROXY_MOCK=false
DOMAIN_VERIFY_MOCK=false
DOMAIN_REGISTRAR_MOCK=false
PROMOTION_INGRESS_HOST=center.parloq.com
PROMOTION_SUCCESS_WEBHOOK_SECRET=change-me-independent-32-character-secret

WA_GATEWAY_INSTANCE_ID=parloq-flow-prod-1
WA_GATEWAY_API_TOKEN=change-me-independent-32-character-token
WA_GATEWAY_WEBHOOK_SECRET=change-me-independent-webhook-secret
WA_GATEWAY_SEND_QPS=10
WA_GATEWAY_ACCOUNT_QUEUE_SIZE=1000
WA_GATEWAY_DATABASE_MAX_CONNECTIONS=50
WA_GATEWAY_WEBHOOK_RETRIES=3
WA_GATEWAY_LOG_LEVEL=info

TASK_WORKER_MAX_CONCURRENCY=200
MIGRATION_SNOWFLAKE_NODE_ID=0
API_SNOWFLAKE_NODE_ID=1
WORKER_SNOWFLAKE_NODE_ID=2
WA_GATEWAY_SNOWFLAKE_NODE_ID=3
